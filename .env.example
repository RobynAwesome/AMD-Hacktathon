# Model providers. Never commit the real .env.
# Default: every step on AMD Token Factory (OpenAI-compatible).
TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
TOKEN_FACTORY_API_KEY=
GEMMA_MODEL=Gemma-4-31B-IT

# Routing: any step can use any provider in goa/providers.json
# GOA_PROVIDER=token_factory          # default for all steps
# GOA_PROVIDER_IDEAS=anthropic        # per-step override
# GOA_MODEL_IDEAS=claude-opus-5-5     # per-step model
# GOA_MODE=dev                        # submission = refuse if a prize-locked step leaves Token Factory

# Other providers (only needed if routed to)
# AI_STUDIO_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
